#!/bin/sh
# arbox: the one door between Claude Code and the Arbox API.
# POSIX sh + curl only. The API key is read from the profiles file and handed
# to curl on stdin; it never appears in argv or in anything this script prints.

ARBOX_EXECUTOR_VERSION="0.9.1"

# Everything this script creates (keys file, logs, --out files, temp files) is owner-only.
umask 077

BASE_DEFAULT="https://arboxserver.arboxapp.com/api/public"
BASE="${ARBOX_BASE_URL:-$BASE_DEFAULT}"
ARBOX_DIR="${ARBOX_HOME:-$HOME/.arbox}"
PROFILES="$ARBOX_DIR/profiles"
PLACEHOLDER="PASTE_YOUR_ARBOX_KEY_HERE"
SELF=$0

TMPD=""
STTY_SAVED=""
cleanup() {
  [ -n "$STTY_SAVED" ] && stty "$STTY_SAVED" 2>/dev/null
  [ -n "$TMPD" ] && rm -rf "$TMPD"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# Set by cmd_read / cmd_write so a policy refusal (exit 5) lands in the activity log.
LOG_VERB=""
LOG_METHOD="-"
LOG_PATH="-"
LOG_QKEYS="-"
LOG_PROFILE="-"

die() { # code message
  code=$1
  shift
  if [ "$code" -eq 5 ] && [ -n "$LOG_VERB" ]; then
    log_activity refused "-"
  fi
  printf '%s\n' "$*" >&2
  exit "$code"
}

# log_activity <status> <rows>: one tab-separated line per call in
# ~/Arbox/logs/activity.log: time, verb, profile, method, path, query keys
# (names only, never values), status or "refused", rows, flags. Never the key
# and never a request or response body.
log_activity() {
  [ -n "$LOG_VERB" ] || return 0
  la_dir="$HOME/Arbox/logs"
  mkdir -p "$la_dir" 2>/dev/null || return 0
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$LOG_VERB" "$LOG_PROFILE" "$LOG_METHOD" "$LOG_PATH" "$LOG_QKEYS" "$1" "$2" "${LOG_FLAGS:--}" >>"$la_dir/activity.log" 2>/dev/null
  return 0
}

# set_qkeys <newline-separated name=value text>: LOG_QKEYS gets the names only.
set_qkeys() {
  LOG_QKEYS=$(printf '%s\n' "$1" | awk -F= 'NF { printf "%s%s", s, $1; s = "," }')
  LOG_QKEYS=${LOG_QKEYS:--}
}

# file_mode <file>: the rwx string, e.g. -rw-------
file_mode() {
  # shellcheck disable=SC2012  # ls -l is the portable way to read a mode string
  ls -ld "$1" | cut -c1-10
}

# file_is_loose <file>: true when group or others have any access.
file_is_loose() {
  [ "$(file_mode "$1" | cut -c5-10)" != "------" ]
}

# setup_hint [profile]: the one command an owner should be told to run to enter
# a key. Always the installed path, always --prompt, always a new Terminal tab
# (a plain `arbox setup` is not on the owner's PATH).
setup_hint() {
  case ${1:-default} in
    default) printf 'Run: ~/.arbox/bin/arbox setup --prompt (in a new Terminal tab)' ;;
    *) printf 'Run: ~/.arbox/bin/arbox setup %s --prompt (in a new Terminal tab)' "$1" ;;
  esac
}

# sanitize_key <value>: sets SANITIZED. Strips what copy-paste and TextEdit add
# around a key: spaces, CR, a leading BOM, straight and curly quotes.
sanitize_key() {
  sk=$1
  sk_cr=$(printf '\r')
  sk_bom=$(printf '\357\273\277')
  sk_lq=$(printf '\342\200\234')
  sk_rq=$(printf '\342\200\235')
  sk_ls=$(printf '\342\200\230')
  sk_rs=$(printf '\342\200\231')
  while :; do
    sk_prev=$sk
    sk=${sk#"${sk%%[![:space:]]*}"}
    sk=${sk%"${sk##*[![:space:]]}"}
    sk=${sk%"$sk_cr"}
    sk=${sk#"$sk_bom"}
    for sk_q in '"' "'" "$sk_lq" "$sk_rq" "$sk_ls" "$sk_rs"; do
      sk=${sk#"$sk_q"}
      sk=${sk%"$sk_q"}
    done
    [ "$sk" = "$sk_prev" ] && break
  done
  SANITIZED=$sk
}

# check_key_shape <profile> <key>: exits 3 with a plain message for a key that
# is empty, a placeholder, has spaces inside, or has characters a key never has.
check_key_shape() {
  if [ -z "$2" ] || [ "$2" = "$PLACEHOLDER" ]; then
    die 3 "The key for profile '$1' has not been filled in yet. $(setup_hint "$1")"
  fi
  case $2 in
    *'{\rtf'*) die 3 "That looks like a Rich Text file, not a key. In TextEdit choose Format > Make Plain Text, save, and paste only the key." ;;
    *[[:space:]]*) die 3 "The key for profile '$1' has spaces inside it. Copy only the key (no label, no extra words) from Arbox." ;;
    *[!A-Za-z0-9._~+/=:-]*) die 3 "The key for profile '$1' contains unexpected characters (spaces or quotes?). Re-copy it from Arbox into $PROFILES" ;;
  esac
}

# resolve_profile <wanted-or-empty>: sets PROFILE and KEY, or exits 3.
resolve_profile() {
  wanted=$1
  [ -f "$PROFILES" ] || die 3 "No Arbox key is set up yet. $(setup_hint)"
  if grep -qF '{\rtf' "$PROFILES" 2>/dev/null; then
    die 3 "The keys file $PROFILES was saved as a Rich Text file by TextEdit. Open it, choose Format > Make Plain Text, save, and make sure each line is name=key."
  fi
  if file_is_loose "$PROFILES"; then
    printf 'Warning: %s can be read by other users on this computer. Run: chmod 600 %s\n' "$PROFILES" "$PROFILES" >&2
  fi
  PROFILE=""
  KEY=""
  first_name=""
  first_val=""
  names=""
  cr=$(printf '\r')
  bom=$(printf '\357\273\277')
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%"$cr"}
    line=${line#"$bom"}
    case $line in '' | '#'*) continue ;; esac
    case $line in *=*) ;; *) continue ;; esac
    name=${line%%=*}
    sanitize_key "${line#*=}"
    val=$SANITIZED
    name=$(printf '%s' "$name" | tr -d ' \t')
    [ -n "$name" ] || continue
    names="$names $name"
    if [ -z "$first_name" ]; then
      first_name=$name
      first_val=$val
    fi
    if [ "$name" = "default" ] && [ -z "$default_seen" ]; then
      default_seen=1
      default_val=$val
    fi
    if [ -n "$wanted" ] && [ "$name" = "$wanted" ] && [ -z "$wanted_seen" ]; then
      wanted_seen=1
      wanted_val=$val
    fi
  done <"$PROFILES"
  if [ -n "$wanted" ]; then
    [ -n "$wanted_seen" ] || die 3 "There is no profile named '$wanted' in $PROFILES. Profiles there:${names:- none}"
    PROFILE=$wanted
    KEY=$wanted_val
  elif [ -n "$default_seen" ]; then
    PROFILE=default
    KEY=$default_val
  elif [ -n "$first_name" ]; then
    PROFILE=$first_name
    KEY=$first_val
  else
    die 3 "No Arbox key is set up yet. $(setup_hint)"
  fi
  check_key_shape "$PROFILE" "$KEY"
  LOG_PROFILE=$PROFILE
}

# urlencode <string>: percent-encode every byte except A-Z a-z 0-9 . _ ~ -
urlencode() {
  printf '%s' "$1" | LC_ALL=C awk '
    BEGIN { for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i }
    { s = (NR > 1 ? "\n" : "") $0
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c ~ /[A-Za-z0-9._~-]/) printf "%s", c
        else printf "%%%02X", ord[c]
      }
    }'
}

# build_query <name=value>...: sets QUERY_STRING ("" or "?a=b&c=d").
build_query() {
  QUERY_STRING=""
  sep="?"
  for kv in "$@"; do
    case $kv in *=*) ;; *) die 2 "Filters look like name=value, got: $kv" ;; esac
    QUERY_STRING="$QUERY_STRING$sep$(urlencode "${kv%%=*}")=$(urlencode "${kv#*=}")"
    sep="&"
  done
}

# check_base_url: ARBOX_BASE_URL may only point at this machine (tests).
check_base_url() {
  [ -n "$ARBOX_BASE_URL" ] || return 0
  rest=""
  case $ARBOX_BASE_URL in
    http://127.0.0.1*) rest=${ARBOX_BASE_URL#http://127.0.0.1} ;;
    http://localhost*) rest=${ARBOX_BASE_URL#http://localhost} ;;
    *) die 5 "ARBOX_BASE_URL may only point at 127.0.0.1 or localhost (for tests). Unset it to talk to Arbox." ;;
  esac
  case $rest in
    '' | /*) ;;
    :*)
      port=${rest#:}
      port=${port%%/*}
      case $port in '' | *[!0-9]*) die 5 "ARBOX_BASE_URL may only point at 127.0.0.1 or localhost (for tests). Unset it to talk to Arbox." ;; esac
      ;;
    *) die 5 "ARBOX_BASE_URL may only point at 127.0.0.1 or localhost (for tests). Unset it to talk to Arbox." ;;
  esac
  case $rest in
    *@* | *[[:space:]]* | *\\*) die 5 "ARBOX_BASE_URL may only point at 127.0.0.1 or localhost (for tests). Unset it to talk to Arbox." ;;
  esac
}

# canon_path <path>: absolute physical path, even if the file does not exist yet.
canon_path() {
  cp_d=$(dirname "$1")
  cp_b=$(basename "$1")
  cp_tail=""
  while [ ! -d "$cp_d" ]; do
    cp_tail="/$(basename "$cp_d")$cp_tail"
    cp_d=$(dirname "$cp_d")
  done
  printf '%s%s/%s' "$(cd "$cp_d" && pwd -P)" "$cp_tail" "$cp_b"
}

# refuse_private_path <path> <what>: exit 5 for anything in the keys folder or a symlink.
refuse_private_path() {
  [ ! -L "$1" ] || die 5 "For safety $2 cannot be a symbolic link."
  rp_c=$(canon_path "$1")
  rp_k=$(canon_path "$ARBOX_DIR/x")
  rp_k=${rp_k%/x}
  case $rp_c in
    "$rp_k" | "$rp_k"/*) die 5 "For safety $2 cannot be inside $ARBOX_DIR, which is private (it holds your keys)." ;;
  esac
}

# confine_out <path>: --out files may only go under ~/Arbox/ (physical path),
# never through '..' or a symbolic link, and never into the keys folder.
confine_out() {
  case $1 in
    .. | ../* | */.. | */../*) die 5 "For safety the --out file cannot contain '..'. Use a path under $HOME/Arbox/, for example $HOME/Arbox/work/list.json" ;;
  esac
  [ ! -L "$1" ] || die 5 "For safety the --out file cannot be a symbolic link."
  co_root=$(canon_path "$HOME/Arbox/x")
  co_root=${co_root%/x}
  case $(canon_path "$1") in
    "$co_root"/*) ;;
    *) die 5 "For safety --out files go under $HOME/Arbox/ only (for example $HOME/Arbox/work/list.json). Got: $1" ;;
  esac
  refuse_private_path "$1" "the --out file"
}

# check_path <path>: plain /v3/... paths only.
check_path() {
  case $1 in /v3/*) ;; *) die 2 "The path must start with /v3/ (for example /v3/locations). Got: $1" ;; esac
  case $1 in
    *[!A-Za-z0-9._~/-]*) die 2 "The path can only contain letters, digits and . _ ~ - /. Put filters after it as name=value. Got: $1" ;;
  esac
  case $1 in
    *..* | *//* | */. | */./*) die 2 "The path contains .. or // which is not allowed. Got: $1" ;;
  esac
}

# --- write allowlist ---------------------------------------------------------
# `arbox write` sends only these v1 operations (tier R1, internal, no undo through the API;
# docs/research/arbox-endpoints.md). Everything else exits 5: money, identity,
# membership changes, bookings, personal details, messages, and anything Arbox
# adds later. Matching is on the exact lower-cased path (no trailing slash).
write_allowed() { # METHOD lowercase-path
  [ "$1" = POST ] || return 1
  case $2 in
    /v3/leads | /v3/leads/updatestatus | /v3/leads/markaslost | /v3/leads/createnote) return 0 ;;
    /v3/tasks | /v3/users/createnote) return 0 ;;
    /v3/tasks/markascompleted/*)
      wa_id=${2#/v3/tasks/markascompleted/}
      case $wa_id in '' | *[!a-z0-9_-]*) return 1 ;; esac
      return 0
      ;;
  esac
  return 1
}
# --- end write allowlist -----------------------------------------------------

make_tmp() {
  [ -n "$TMPD" ] && return 0
  umask 077
  TMPD=$(mktemp -d "${TMPDIR:-/tmp}/arbox.XXXXXX") || die 1 "Could not create a temporary folder."
}

# scrub_file <file>: replace every copy of the current key with [key hidden].
# The key reaches awk through a private file, never argv or the environment.
scrub_file() {
  printf '%s\n' "$KEY" >"$TMPD/key"
  awk 'NR == FNR { k = $0; next }
       { s = $0; out = ""
         while (k != "" && (i = index(s, k)) > 0) { out = out substr(s, 1, i - 1) "[key hidden]"; s = substr(s, i + length(k)) }
         print out s }' "$TMPD/key" "$1" >"$1.scrubbed" && mv "$1.scrubbed" "$1"
}

# api_call <METHOD> <path> [extra curl args...]
# Sets HTTP_STATUS and BODY_FILE (scrubbed). Exits 4 on network or HTTP errors.
api_call() {
  method=$1
  apath=$2
  shift 2
  make_tmp
  BODY_FILE="$TMPD/body"
  attempt=1
  while :; do
    curl_rc=0
    HTTP_STATUS=$(printf 'header = "api-key: %s"\n' "$KEY" |
      curl --config - -sS --connect-timeout 10 --max-time 60 -X "$method" \
        -o "$BODY_FILE" -w '%{http_code}' "$@" "$BASE$apath$QUERY_STRING") || curl_rc=$?
    if [ "$curl_rc" -ne 0 ]; then
      log_activity 000 -
      die 4 "Could not reach Arbox (curl error $curl_rc). Check the internet connection and try again."
    fi
    [ -f "$BODY_FILE" ] || : >"$BODY_FILE"
    scrub_file "$BODY_FILE"
    # Arbox answers 429 while another call with the same key is running. Reads
    # wait and try again; writes never repeat (a duplicate cannot be undone).
    [ "$HTTP_STATUS" = 429 ] && [ "$method" = GET ] && [ "$attempt" -lt 3 ] || break
    log_activity 429 -
    printf 'Arbox is busy with another request (HTTP 429); trying again in %s s.\n' "$attempt" >&2
    sleep "$attempt"
    attempt=$((attempt + 1))
  done
  log_rows="-"
  if [ "$method" = GET ] && command -v jq >/dev/null 2>&1; then
    log_rows=$(jq -e '.data | length' "$BODY_FILE" 2>/dev/null) || log_rows="-"
  fi
  log_activity "$HTTP_STATUS" "$log_rows"
  case $HTTP_STATUS in
    2??) return 0 ;;
    404) printf 'Arbox could not find that (HTTP 404). The address or an id in it may be wrong, or the record may be gone.\n' >&2 ;;
    401 | 403) printf "Arbox rejected the key for profile '%s' (HTTP %s). Check it in Arbox -> Settings, then enter it again. %s\n" "$PROFILE" "$HTTP_STATUS" "$(setup_hint "$PROFILE")" >&2 ;;
    429) printf 'Arbox refused while another request was running (HTTP 429). Run calls one after another, then try again.\n' >&2 ;;
    5??) printf 'Arbox had a problem on its side (HTTP %s). Try again in a minute.\n' "$HTTP_STATUS" >&2 ;;
    *) printf 'Arbox returned HTTP %s.\n' "$HTTP_STATUS" >&2 ;;
  esac
  printf 'Arbox said: ' >&2
  head -c 2000 "$BODY_FILE" >&2
  printf '\n' >&2
  exit 4
}

# real_self: absolute path of the file being run, symlinks resolved.
real_self() {
  rs_s=$SELF
  while [ -L "$rs_s" ]; do
    rs_t=$(readlink "$rs_s")
    case $rs_t in
      /*) rs_s=$rs_t ;;
      *) rs_s="$(dirname "$rs_s")/$rs_t" ;;
    esac
  done
  rs_d=$(cd "$(dirname "$rs_s")" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s' "$rs_d" "$(basename "$rs_s")"
}

# script_version <file>: the ARBOX_EXECUTOR_VERSION a script file declares.
script_version() {
  sed -n 's/^ARBOX_EXECUTOR_VERSION="\(.*\)"$/\1/p' "$1" 2>/dev/null | head -n 1
}

# version_cmp <a> <b>: prints lt, eq or gt, comparing dotted numbers.
version_cmp() {
  awk -v a="$1" -v b="$2" 'BEGIN {
    na = split(a, x, "."); nb = split(b, y, "."); n = (na > nb ? na : nb)
    for (i = 1; i <= n; i++) {
      if (x[i] + 0 < y[i] + 0) { print "lt"; exit }
      if (x[i] + 0 > y[i] + 0) { print "gt"; exit }
    }
    print "eq" }'
}

# tilde_path <path>: show a path under $HOME as ~/...
tilde_path() {
  # shellcheck disable=SC2088  # a literal ~ is the point: it is shown to the owner
  case $1 in
    "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# install_tip: one stderr line when this copy is not ~/.arbox/bin/arbox, so the
# permission rules (which name that path) apply. Never fails the command.
install_tip() {
  [ -z "${ARBOX_NO_TIP:-}" ] || return 0
  it_self=$(real_self) || return 0
  [ "$(canon_path "$SELF")" != "$(canon_path "$ARBOX_DIR/bin/arbox")" ] || return 0
  printf "tip: run 'sh %s install' once, then always use ~/.arbox/bin/arbox\n" "$it_self" >&2
  return 0
}

# cmd_install: copy this script to ~/.arbox/bin/arbox and assets/demo to
# ~/.arbox/demo. Idempotent. Never touches the profiles file.
cmd_install() {
  src=$(real_self) || die 1 "Cannot find where this script lives."
  target="$ARBOX_DIR/bin/arbox"
  mkdir -p "$ARBOX_DIR/bin" || die 1 "Could not create $ARBOX_DIR/bin"
  chmod 700 "$ARBOX_DIR" "$ARBOX_DIR/bin" 2>/dev/null
  changed=""
  was=""
  if [ "$src" != "$(canon_path "$target")" ] && ! { [ -f "$target" ] && [ ! -L "$target" ] && cmp -s "$src" "$target"; }; then
    [ ! -f "$target" ] || was=$(script_version "$target")
    cp "$src" "$target.new.$$" || die 1 "Could not copy to $target"
    chmod 700 "$target.new.$$"
    mv "$target.new.$$" "$target" || { rm -f "$target.new.$$"; die 1 "Could not install $target"; }
    changed=1
  fi
  demo_src="$(dirname "$src")/../assets/demo"
  if [ -d "$demo_src" ] && [ "$(cd "$demo_src" && pwd -P)" != "$(cd "$ARBOX_DIR/demo" 2>/dev/null && pwd -P)" ]; then
    if ! diff -r "$demo_src" "$ARBOX_DIR/demo" >/dev/null 2>&1; then
      rm -rf "$ARBOX_DIR/demo.new.$$"
      cp -R "$demo_src" "$ARBOX_DIR/demo.new.$$" || die 1 "Could not copy the sample data to $ARBOX_DIR/demo"
      chmod -R go-rwx "$ARBOX_DIR/demo.new.$$" 2>/dev/null
      rm -rf "$ARBOX_DIR/demo"
      mv "$ARBOX_DIR/demo.new.$$" "$ARBOX_DIR/demo" || die 1 "Could not install $ARBOX_DIR/demo"
      changed=1
    fi
  fi
  if [ -n "$changed" ]; then
    if [ -n "$was" ] && [ "$was" != "$ARBOX_EXECUTOR_VERSION" ]; then
      printf 'installed arbox %s at %s (upgraded from %s)\n' "$ARBOX_EXECUTOR_VERSION" "$(tilde_path "$target")" "$was"
    else
      printf 'installed arbox %s at %s\n' "$ARBOX_EXECUTOR_VERSION" "$(tilde_path "$target")"
    fi
  else
    printf 'arbox %s is already up to date at %s\n' "$ARBOX_EXECUTOR_VERSION" "$(tilde_path "$target")"
  fi
}

# demo_dir: where the sample fixtures live. Next to the script (the source
# tree: ../assets/demo, symlinks resolved), or ~/.arbox/demo after install.
demo_dir() {
  dd_here=$(dirname "$(real_self)")
  if [ -d "$dd_here/../assets/demo" ]; then
    printf '%s' "$dd_here/../assets/demo"
  elif [ -d "$ARBOX_DIR/demo" ]; then
    printf '%s' "$ARBOX_DIR/demo"
  fi
}

# serve_demo <path> <filters>: answer from a bundled fixture. No key, no network.
serve_demo() {
  sd_path=$1
  sd_filters=$2
  make_tmp
  sd_dir=$(demo_dir)
  sd_file="$sd_dir/$(printf '%s' "${sd_path#/}" | sed 's,/,__,g').json"
  if [ -n "$sd_dir" ] && [ -f "$sd_file" ]; then
    sd_page=$(printf '%s\n' "$sd_filters" | sed -n 's/^page=\([0-9][0-9]*\)$/\1/p' | head -n 1)
    if [ "${sd_page:-1}" -gt 1 ]; then
      printf '%s\n' '{"statusCode":200,"data":[],"extra":[]}' >"$TMPD/body"
    else
      cp "$sd_file" "$TMPD/body"
    fi
  else
    log_activity 404 -
    die 4 "There is no sample data for $sd_path in demo mode."
  fi
  sd_rows="-"
  if command -v jq >/dev/null 2>&1; then
    sd_rows=$(jq -e '.data | length' "$TMPD/body" 2>/dev/null) || sd_rows="-"
  fi
  log_activity demo "$sd_rows"
  printf 'SAMPLE DATA (demo mode): this is a made-up studio, not your Arbox data.\n' >&2
  emit_result "$TMPD/body" ""
}

cmd_read() {
  profile=""
  path=""
  filters=""
  out=""
  all=""
  demo=""
  bad_method=""
  first=1
  LOG_VERB="read"
  LOG_METHOD=GET
  case ${ARBOX_DEMO:-} in '' | 0) ;; *) demo=1 ;; esac
  while [ $# -gt 0 ]; do
    case $1 in
      -p)
        [ $# -ge 2 ] || die 2 "-p needs a profile name"
        profile=$2
        shift 2
        continue
        ;;
      --out)
        [ $# -ge 2 ] || die 2 "--out needs a file name"
        out=$2
        first=0
        shift 2
        continue
        ;;
      --all)
        all=1
        first=0
        shift
        continue
        ;;
      --demo)
        demo=1
        shift
        continue
        ;;
      GET | POST | PATCH | PUT | DELETE)
        if [ "$first" -eq 1 ]; then
          [ "$1" = GET ] || bad_method=$1
          first=0
          shift
          continue
        fi
        ;;
    esac
    first=0
    if [ -z "$path" ]; then
      path=$1
    else
      filters="$filters$1
"
    fi
    shift
  done
  case $path in
    *\?*)
      # Agents often type /v3/x?a=b&c=d; take it as the filters a=b c=d.
      rq=${path#*\?}
      path=${path%%\?*}
      qf=""
      eg=""
      while [ -n "$rq" ]; do
        kv=${rq%%&*}
        case $rq in *\&*) rq=${rq#*&} ;; *) rq="" ;; esac
        [ -n "$kv" ] || continue
        qf="$qf$kv
"
        eg="$eg ${kv%%=*}=..."
      done
      # %, + and # mean something else in a URL; ask for the plain form instead of guessing.
      case $qf in *[%+#]*) die 2 "Put filters after the path as name=value in plain text (no %, + or # URL codes). For example: arbox read $path$eg" ;; esac
      filters="$qf$filters"
      ;;
  esac
  LOG_PATH=${path:--}
  set_qkeys "$filters"
  [ -z "$demo" ] || LOG_VERB=demo
  if [ -n "$bad_method" ]; then
    LOG_METHOD=$bad_method
    die 5 "'arbox read' only does GET. To change something use 'arbox write' (and ask the owner first)."
  fi
  [ -n "$path" ] || die 2 "usage: arbox read [-p profile] [--demo] /v3/path [name=value ...]"
  [ -z "$out" ] || confine_out "$out"
  check_path "$path"
  lp=$(printf '%s' "$path" | tr '[:upper:]' '[:lower:]')
  case $lp in
    /v3/schedule/entryfromwaitinglist | /v3/schedule/entryfromwaitinglist/)
      # LIVE CHECK pending: Arbox has not said what confirm= does here. If it
      # promotes someone off the waiting list, this GET would be a member-facing write.
      if printf '%s\n' "$filters" | tr '[:upper:]' '[:lower:]' | grep -q '^confirm='; then
        die 5 "This lookup might change something in Arbox when confirm is given (LIVE CHECK pending: not verified yet), so it is not done through 'arbox read'. Please do it in the Arbox app."
      fi
      ;;
  esac
  if [ -n "$demo" ]; then
    serve_demo "$path" "$filters"
    return
  fi
  check_base_url
  resolve_profile "$profile"
  set --
  while IFS= read -r kv; do
    [ -n "$kv" ] && set -- "$@" "$kv"
  done <<EOF
$filters
EOF
  if [ -n "$all" ]; then
    for kv in "$@"; do
      case $kv in page=* | limit=*) die 2 "--all pages by itself; do not set page= or limit= with --all." ;; esac
    done
    if [ -z "$out" ] && ! command -v jq >/dev/null 2>&1; then
      die 2 "Without jq installed, --all needs --out FILE (it saves one file per page and a manifest)."
    fi
    fetch_all "$path" "$@"
    return
  fi
  build_query "$@"
  api_call GET "$path"
  emit_result "$BODY_FILE" ""
}

# emit_result <file> <extra summary>: print the body, or with --out save it
# privately and print a one-line summary.
emit_result() {
  if [ -z "$out" ]; then
    cat "$1"
    return
  fi
  mkdir -p "$(dirname "$out")" || die 1 "Could not create the folder for $out"
  umask 077
  cat "$1" >"$out" || die 1 "Could not write $out"
  chmod 600 "$out" 2>/dev/null
  if command -v jq >/dev/null 2>&1 && rows=$(jq -e '.data | length' "$out" 2>/dev/null); then
    printf 'Saved %s rows to %s%s\n' "$rows" "$out" "$2"
  else
    printf 'Saved %s bytes to %s (install jq to see row counts)%s\n' "$(wc -c <"$out" | tr -d ' ')" "$out" "$2"
  fi
}

# fetch_all <path> [filters...]: page=1.. with limit=500 until a short page, at
# most 20 pages. With jq the pages are merged; without it each page is kept as
# OUT.page-N.json with OUT.manifest.txt.
fetch_all() {
  fpath=$1
  shift
  build_query "$@"
  base_query=$QUERY_STRING
  sep="?"
  [ -n "$base_query" ] && sep="&"
  have_jq=""
  command -v jq >/dev/null 2>&1 && have_jq=1
  n=1
  capped=""
  total=0
  make_tmp
  : >"$TMPD/pages.list"
  while :; do
    QUERY_STRING="$base_query${sep}page=$n&limit=500"
    api_call GET "$fpath"
    if [ -n "$have_jq" ]; then
      rows=$(jq -e '.data | length' "$BODY_FILE" 2>/dev/null) || die 4 "Arbox answered, but not with a list I can read (page $n)."
    else
      if grep -q '"data": *\[ *\]' "$BODY_FILE"; then
        rows=0
      else
        rows=500
      fi
    fi
    if [ "$rows" -gt 0 ]; then
      cp "$BODY_FILE" "$TMPD/page-$n.json"
      printf '%s\n' "$TMPD/page-$n.json" >>"$TMPD/pages.list"
      total=$((total + rows))
    fi
    [ "$rows" -lt 500 ] && break
    if [ "$n" -ge 20 ]; then
      capped=1
      break
    fi
    n=$((n + 1))
  done
  if [ "$total" -eq 0 ]; then
    # No page had rows: answer with an empty envelope, whether or not jq exists.
    printf '%s\n' '{"statusCode":200,"data":[],"extra":[]}' >"$TMPD/merged.json"
    if [ -n "$out" ]; then
      mkdir -p "$(dirname "$out")" || die 1 "Could not create the folder for $out"
      cat "$TMPD/merged.json" >"$out" || die 1 "Could not write $out"
      chmod 600 "$out" 2>/dev/null
      printf 'Saved 0 rows to %s\n' "$out"
    else
      cat "$TMPD/merged.json"
    fi
    return
  fi
  note=""
  if [ -n "$capped" ]; then
    note=" INCOMPLETE: stopped at 20 pages"
    printf 'Warning: stopped after 20 pages (%s rows); there may be more. Narrow the request with dates or a location.\n' "$total" >&2
  fi
  if [ -n "$have_jq" ]; then
    xargs jq -s '{statusCode: 200, data: (map(.data) | add // []), extra: []}' <"$TMPD/pages.list" >"$TMPD/merged.json" 2>/dev/null ||
      jq -s '{statusCode: 200, data: [], extra: []}' </dev/null >"$TMPD/merged.json"
    emit_result "$TMPD/merged.json" "$note"
  else
    mkdir -p "$(dirname "$out")" || die 1 "Could not create the folder for $out"
    umask 077
    : >"$out.manifest.txt"
    i=1
    while IFS= read -r pf; do
      cp "$pf" "$out.page-$i.json"
      printf '%s.page-%s.json\n' "$out" "$i" >>"$out.manifest.txt"
      i=$((i + 1))
    done <"$TMPD/pages.list"
    printf 'jq is not installed, so the pages were not merged. Saved %s pages (about %s rows) listed in %s.%s\n' "$((i - 1))" "$total" "$out.manifest.txt" "$note"
  fi
}

cmd_write() {
  profile=""
  method=""
  path=""
  body=""
  body_file=""
  confirmed=""
  filters=""
  LOG_VERB="write"
  while [ $# -gt 0 ]; do
    case $1 in
      -p)
        [ $# -ge 2 ] || die 2 "-p needs a profile name"
        profile=$2
        shift 2
        ;;
      --body)
        [ $# -ge 2 ] || die 2 "--body needs a JSON string"
        body=$2
        shift 2
        ;;
      --body-file)
        [ $# -ge 2 ] || die 2 "--body-file needs a file name"
        body_file=$2
        shift 2
        ;;
      --yes-i-confirmed)
        confirmed=1
        shift
        ;;
      *)
        if [ -z "$method" ]; then
          method=$1
        elif [ -z "$path" ]; then
          path=$1
        else
          filters="$filters$1
"
        fi
        shift
        ;;
    esac
  done
  [ -n "$method" ] && [ -n "$path" ] || die 2 "usage: arbox write [-p profile] POST|PATCH /v3/path [name=value ...] [--body JSON | --body-file FILE] --yes-i-confirmed"
  method=$(printf '%s' "$method" | tr '[:lower:]' '[:upper:]')
  LOG_METHOD=$method
  LOG_PATH=$path
  set_qkeys "$filters"
  [ -z "$confirmed" ] || LOG_FLAGS=confirmed
  lp=$(printf '%s' "$path" | tr '[:upper:]' '[:lower:]')
  booking_msg="Bookings and cancellations are not done by the agent in v1. Please do this in the Arbox app; I can prepare the list of who to book or cancel."
  case $method in
    GET) die 5 "'arbox write' never does GET. To look something up use 'arbox read'." ;;
    DELETE)
      case $lp in /v3/schedule | /v3/schedule/*) die 5 "$booking_msg" ;; esac
      die 5 "Deleting is not available through this tool. Please do it in the Arbox app, where it is deliberate."
      ;;
    POST | PATCH) ;;
    *) die 2 "Arbox only needs POST or PATCH for writes. Got: $method" ;;
  esac
  case ${ARBOX_DEMO:-} in '' | 0) ;; *) die 5 "Demo mode (ARBOX_DEMO is set) only shows sample data and never changes anything. Unset ARBOX_DEMO to make a real change." ;; esac
  check_base_url
  check_path "$path"
  case $lp in /v3/schedule | /v3/schedule/*) die 5 "$booking_msg" ;; esac
  if ! write_allowed "$method" "$lp"; then
    die 5 "This change is not one this tool makes (money, membership status, merging people, personal details, messaging members, bookings and anything not on the short list of safe edits). Please do it in the Arbox app."
  fi
  # --yes-i-confirmed is an audit marker, not a security gate: it records in the
  # activity log that the agent says the owner approved this exact change. The
  # real gate is the harness permission prompt on `arbox write`.
  [ -n "$confirmed" ] || die 2 "Writes need --yes-i-confirmed, added only after the owner has said yes to this exact change."
  [ -z "$body" ] || [ -z "$body_file" ] || die 2 "Use either --body or --body-file, not both."
  if [ -n "$body_file" ]; then
    [ -r "$body_file" ] || die 2 "Cannot read the body file: $body_file"
    refuse_private_path "$body_file" "the body file"
  fi
  resolve_profile "$profile"
  make_tmp
  if [ -n "$body" ]; then
    printf '%s' "$body" >"$TMPD/payload"
    body_file="$TMPD/payload"
  fi
  set --
  while IFS= read -r kv; do
    [ -n "$kv" ] && set -- "$@" "$kv"
  done <<EOF
$filters
EOF
  build_query "$@"
  if [ -n "$body_file" ]; then
    api_call "$method" "$path" -H 'Content-Type: application/json' --data-binary "@$body_file"
  else
    api_call "$method" "$path" -H 'Content-Type: application/json'
  fi
  cat "$BODY_FILE"
}

# profile_names: the names in the profiles file, once each, never the keys.
profile_names() {
  [ -f "$PROFILES" ] || return 0
  cr=$(printf '\r')
  bom=$(printf '\357\273\277')
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%"$cr"}
    line=${line#"$bom"}
    case $line in '' | '#'*) continue ;; esac
    case $line in *=*) ;; *) continue ;; esac
    printf '%s\n' "${line%%=*}" | tr -d ' \t'
  done <"$PROFILES" | awk 'NF && !seen[$0]++'
}

# profile_state <name>: one phrase about that profile's key, never the key.
profile_state() {
  msg=$( (resolve_profile "$1") 2>&1 >/dev/null) && { echo "key set"; return; }
  case $msg in
    *"has not been filled in"*) echo "key NOT filled in" ;;
    *"unexpected characters"*) echo "key has unexpected characters" ;;
    *"spaces inside"*) echo "key has spaces inside it (copy only the key)" ;;
    *"Rich Text"*) echo "file was saved as Rich Text (open it in TextEdit, Format > Make Plain Text)" ;;
    *) echo "problem with the key" ;;
  esac
}

usage_text() {
  cat <<'USAGE'
arbox: safe access to the Arbox API

  arbox setup [name] --prompt        type the key with hidden input (open a new Terminal tab first)
  arbox setup [name] [--open]        or create the private keys file and edit it in TextEdit
  arbox profiles                     list your key profiles (names only)
  arbox doctor [--online]            check this computer and your keys
  arbox read [-p name] /v3/path [name=value ...] [--out FILE] [--all]
                                     look things up (GET only; --out files go under ~/Arbox)
  arbox read --demo /v3/path         the same on made-up sample data (no key needed)
  arbox install                      copy this tool to ~/.arbox/bin/arbox (run once, then always use that path)
  arbox --version                    print the version
  arbox write [-p name] POST|PATCH /v3/path [name=value ...]
              [--body JSON | --body-file FILE] --yes-i-confirmed
                                     change something, only after the owner said yes
USAGE
}

# setup_prompt <name>: read a key with echo off and write or replace that
# profile's line. The key lives in a shell variable and goes out through the
# printf builtin only: never argv, never output.
setup_prompt() {
  sp_name=$1
  # The test hook feeds a key without a terminal, and only against localhost.
  if [ -n "${ARBOX_TEST_KEY_INPUT+set}" ] && [ -n "$ARBOX_BASE_URL" ] && (check_base_url) >/dev/null 2>&1; then
    sp_typed=$ARBOX_TEST_KEY_INPUT
  elif [ -t 0 ]; then
    printf 'Paste your Arbox key (nothing will show as you paste), then press Return: ' >&2
    STTY_SAVED=$(stty -g 2>/dev/null)
    stty -echo 2>/dev/null
    IFS= read -r sp_typed
    [ -z "$STTY_SAVED" ] || stty "$STTY_SAVED" 2>/dev/null
    STTY_SAVED=""
    printf '\n' >&2
  else
    die 2 "This step needs a real terminal so the key stays hidden. Please open a new Terminal tab and run: ~/.arbox/bin/arbox setup --prompt"
  fi
  sanitize_key "$sp_typed"
  sp_typed=""
  [ -n "$SANITIZED" ] || die 3 "Nothing was entered, so nothing was saved."
  check_key_shape "$sp_name" "$SANITIZED"
  sp_new="$ARBOX_DIR/profiles.new.$$"
  sp_cr=$(printf '\r')
  sp_bom=$(printf '\357\273\277')
  sp_done=""
  {
    if [ -f "$PROFILES" ]; then
      while IFS= read -r sp_line || [ -n "$sp_line" ]; do
        sp_plain=${sp_line%"$sp_cr"}
        sp_plain=${sp_plain#"$sp_bom"}
        case $sp_plain in
          '#'*) printf '%s\n' "$sp_line"; continue ;;
          *=*) ;;
          *) printf '%s\n' "$sp_line"; continue ;;
        esac
        sp_lname=$(printf '%s' "${sp_plain%%=*}" | tr -d ' \t')
        if [ "$sp_lname" = "$sp_name" ]; then
          # first line for this name is replaced, later duplicates are dropped
          [ -n "$sp_done" ] || printf '%s=%s\n' "$sp_name" "$SANITIZED"
          sp_done=1
        else
          printf '%s\n' "$sp_line"
        fi
      done <"$PROFILES"
    else
      printf '# Arbox API keys, one per line:  name=key\n# Keep this file private. Never share it or paste it into a chat.\n'
    fi
    [ -n "$sp_done" ] || printf '%s=%s\n' "$sp_name" "$SANITIZED"
  } >"$sp_new" || { rm -f "$sp_new"; die 1 "Could not write $PROFILES"; }
  chmod 600 "$sp_new" 2>/dev/null
  mv "$sp_new" "$PROFILES" || { rm -f "$sp_new"; die 1 "Could not write $PROFILES"; }
  SANITIZED=""
  printf "Saved the key for profile '%s' (it was not shown or printed).\nNext, check it with:  arbox doctor --online\n" "$sp_name"
}

cmd_setup() {
  name=default
  want_open=""
  want_prompt=""
  for a in "$@"; do
    case $a in
      --open) want_open=1 ;;
      --prompt) want_prompt=1 ;;
      -*) die 2 "Unknown option: $a" ;;
      *) name=$a ;;
    esac
  done
  case $name in
    '' | *[!A-Za-z0-9_-]*) die 2 "Profile names are short labels like 'default' or 'downtown'. Please never type or paste a key on the command line; it is entered in the file this command creates." ;;
  esac
  [ "${#name}" -le 24 ] || die 2 "Profile names are short labels like 'default' or 'downtown'. Please never type or paste a key on the command line; it is entered in the file this command creates."
  mkdir -p "$ARBOX_DIR" || die 1 "Could not create $ARBOX_DIR"
  chmod 700 "$ARBOX_DIR" 2>/dev/null
  if [ -n "$want_prompt" ]; then
    setup_prompt "$name"
    return
  fi
  if [ ! -f "$PROFILES" ]; then
    printf '# Arbox API keys, one per line:  name=key\n# Keep this file private. Never share it or paste it into a chat.\n%s=%s\n' "$name" "$PLACEHOLDER" >"$PROFILES"
  elif ! grep -q "^[[:space:]]*${name}[[:space:]]*=" "$PROFILES"; then
    [ -z "$(tail -c 1 "$PROFILES")" ] || printf '\n' >>"$PROFILES"
    printf '%s=%s\n' "$name" "$PLACEHOLDER" >>"$PROFILES"
  fi
  chmod 600 "$PROFILES" 2>/dev/null
  cat <<EOF
Arbox setup (profile: $name)

1. In Arbox, open Settings and find your API key. If you cannot see it, ask
   Arbox support or your account manager to enable API access.
2. Easiest: open a new Terminal tab and run
     ~/.arbox/bin/arbox setup $name --prompt
   and paste the key there (nothing shows as you paste).
   Or open this file in a plain-text editor:
     $PROFILES
   and replace $PLACEHOLDER after "$name=" with your key, nothing else, and save.
3. Then run:  arbox doctor --online

Please never paste your key into a chat with Claude or anyone else. It goes in
that file only.
EOF
  if [ -n "$want_open" ]; then
    if [ "$(uname -s 2>/dev/null)" = Darwin ] && command -v open >/dev/null 2>&1; then
      open -e "$PROFILES"
    else
      printf '(Open the file above with any text editor; --open only works on a Mac.)\n'
    fi
  fi
}

cmd_profiles() {
  [ -f "$PROFILES" ] || die 3 "No Arbox key is set up yet. $(setup_hint)"
  names=$(profile_names)
  [ -n "$names" ] || die 3 "The profiles file has no profiles yet. $(setup_hint)"
  printf '%s\n' "$names" | while IFS= read -r n; do
    state=$(profile_state "$n")
    case $state in "key set") state="key set" ;; "key NOT filled in") state="not filled in yet" ;; esac
    printf '%s: %s\n' "$n" "$state"
  done
}

# json_unescape: stdin lines of JSON string contents (no surrounding quotes) to
# plain UTF-8: \uXXXX (with surrogate pairs), \" \\ \/ and the usual \n \t.
# Arbox, like PHP's json_encode, sends Hebrew as \u05e1-style escapes.
json_unescape() {
  LC_ALL=C awk '
    function hexval(s,   i, v) {
      v = 0
      for (i = 1; i <= length(s); i++) v = v * 16 + index("0123456789abcdef", tolower(substr(s, i, 1))) - 1
      return v
    }
    function utf8(cp) {
      if (cp < 128) return sprintf("%c", cp)
      if (cp < 2048) return sprintf("%c%c", 192 + int(cp / 64), 128 + cp % 64)
      if (cp < 65536) return sprintf("%c%c%c", 224 + int(cp / 4096), 128 + int(cp / 64) % 64, 128 + cp % 64)
      return sprintf("%c%c%c%c", 240 + int(cp / 262144), 128 + int(cp / 4096) % 64, 128 + int(cp / 64) % 64, 128 + cp % 64)
    }
    {
      s = $0; out = ""
      while (length(s) > 0) {
        c = substr(s, 1, 1)
        if (c != "\\" || length(s) < 2) { out = out c; s = substr(s, 2); continue }
        n = substr(s, 2, 1)
        if (n == "u" && substr(s, 3, 4) ~ /^[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]$/) {
          cp = hexval(substr(s, 3, 4)); s = substr(s, 7)
          if (cp >= 55296 && cp < 56320 && substr(s, 1, 2) == "\\u" && substr(s, 3, 4) ~ /^[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]$/) {
            lo = hexval(substr(s, 3, 4))
            if (lo >= 56320 && lo < 57344) { cp = 65536 + (cp - 55296) * 1024 + (lo - 56320); s = substr(s, 7) }
          }
          out = out utf8(cp)
        } else if (n == "n" || n == "r" || n == "t") { out = out " "; s = substr(s, 3) }
        else { out = out n; s = substr(s, 3) }
      }
      print out
    }'
}

# doctor_installed_copy: is ~/.arbox/bin/arbox present and as new as this copy?
doctor_installed_copy() {
  dc_target="$ARBOX_DIR/bin/arbox"
  dc_shown=$(tilde_path "$dc_target")
  dc_self=$(real_self) || return 0
  if [ "$(canon_path "$SELF")" = "$(canon_path "$dc_target")" ] || [ "$dc_self" = "$(canon_path "$dc_target")" ]; then
    printf '  installed copy: this is the installed copy (%s)\n' "$dc_shown"
    return 0
  fi
  if [ ! -f "$dc_target" ]; then
    printf "  installed copy: not installed. Run: sh %s install\n" "$dc_self"
    return 0
  fi
  dc_v=$(script_version "$dc_target")
  case $(version_cmp "${dc_v:-0}" "$ARBOX_EXECUTOR_VERSION") in
    lt) printf "  installed copy: arbox %s at %s is OLDER than this copy (%s). Run: sh %s install\n" "$dc_v" "$dc_shown" "$ARBOX_EXECUTOR_VERSION" "$dc_self" ;;
    gt) printf '  installed copy: arbox %s at %s is NEWER than this copy (%s)\n' "$dc_v" "$dc_shown" "$ARBOX_EXECUTOR_VERSION" ;;
    *)
      if cmp -s "$dc_self" "$dc_target"; then
        printf '  installed copy: arbox %s at %s, up to date\n' "$dc_v" "$dc_shown"
      else
        printf "  installed copy: arbox %s at %s differs from this copy (same version number). Run: sh %s install\n" "$dc_v" "$dc_shown" "$dc_self"
      fi
      ;;
  esac
}

cmd_doctor() {
  online=""
  [ "$1" = "--online" ] && online=1
  code=0
  reason=""
  printf 'Arbox doctor\n'
  printf '  executor: arbox %s\n' "$ARBOX_EXECUTOR_VERSION"
  doctor_installed_copy
  printf '  system: %s %s\n' "$(uname -s 2>/dev/null)" "$(uname -m 2>/dev/null)"
  if [ -n "$ARBOX_BASE_URL" ]; then
    printf '  testing mode: talking to %s instead of Arbox\n' "$ARBOX_BASE_URL"
  fi
  if command -v curl >/dev/null 2>&1; then
    printf '  curl: %s\n' "$(curl --version 2>/dev/null | head -n 1)"
  else
    printf '  curl: NOT FOUND (this tool cannot work without it)\n'
    code=1
    reason="curl is missing"
  fi
  if command -v jq >/dev/null 2>&1; then
    printf '  jq: installed (%s)\n' "$(command -v jq)"
  else
    printf '  jq: not installed (optional; needed to merge --all pages and count rows)\n'
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    printf '  python3: not installed (optional)\n'
  elif [ "$(uname -s 2>/dev/null)" = Darwin ] && ! xcode-select -p >/dev/null 2>&1; then
    printf '  python3: not used (this Mac has no developer tools; running it would pop up an install window)\n'
  else
    printf '  python3: %s\n' "$(python3 --version 2>&1 | head -n 1)"
  fi
  if command -v node >/dev/null 2>&1; then
    printf '  node: %s\n' "$(node --version 2>&1 | head -n 1)"
  else
    printf '  node: not installed (optional)\n'
  fi
  names=""
  if [ -f "$PROFILES" ]; then
    m=$(file_mode "$PROFILES")
    if [ "$m" = "-rw-------" ]; then
      printf '  keys file: %s (mode 600)\n' "$PROFILES"
    else
      printf '  keys file: %s (mode %s)\n' "$PROFILES" "$m"
    fi
    if file_is_loose "$PROFILES"; then
      printf '  WARNING: the keys file is readable by other users on this computer. Run: chmod 600 %s\n' "$PROFILES"
    fi
    names=$(profile_names)
  else
    printf '  keys file: %s (missing)\n' "$PROFILES"
  fi
  ready_profiles=""
  if [ -n "$names" ]; then
    for n in $names; do
      state=$(profile_state "$n")
      printf '  %s: %s\n' "$n" "$state"
      [ "$state" = "key set" ] && ready_profiles="$ready_profiles $n"
    done
  fi
  if [ -z "$ready_profiles" ] && [ "$code" -eq 0 ]; then
    code=3
    reason="no key is filled in yet. $(setup_hint)"
  fi
  if [ -n "$online" ] && [ "$code" -ne 1 ]; then
    for n in $ready_profiles; do
      res_rc=0
      res=$(ARBOX_NO_TIP=1 sh "$SELF" read -p "$n" /v3/locations 2>&1) || res_rc=$?
      if [ "$res_rc" -eq 0 ]; then
        locs=$(printf '%s\n' "$res" | grep -oE '"location_name" *: *"([^"\\]|\\.)*"' | sed 's/^"location_name" *: *"//; s/"$//' | json_unescape)
        count=$(printf '%s\n' "$locs" | grep -c .)
        label=locations
        [ "$count" -eq 1 ] && label=location
        printf '  %s: connected, %s %s (%s)\n' "$n" "$count" "$label" "$(printf '%s\n' "$locs" | awk 'NF { printf "%s%s", s, $0; s = ", " }')"
      else
        printf '  %s: %s\n' "$n" "$(printf '%s' "$res" | head -n 1)"
        [ "$code" -eq 0 ] && code=4 && reason="Arbox did not accept every key"
      fi
    done
  fi
  if [ "$code" -eq 0 ]; then
    printf 'READY\n'
  else
    printf 'NOT READY: %s\n' "$reason"
  fi
  exit "$code"
}

cmd=$1
[ $# -gt 0 ] && shift
case $cmd in
  read)
    install_tip
    cmd_read "$@"
    ;;
  write)
    install_tip
    cmd_write "$@"
    ;;
  setup)
    install_tip
    cmd_setup "$@"
    ;;
  profiles)
    install_tip
    cmd_profiles "$@"
    ;;
  doctor)
    install_tip
    cmd_doctor "$@"
    ;;
  install) cmd_install ;;
  --version | version) printf 'arbox %s\n' "$ARBOX_EXECUTOR_VERSION" ;;
  help | --help | -h)
    usage_text
    ;;
  *)
    usage_text >&2
    exit 2
    ;;
esac
